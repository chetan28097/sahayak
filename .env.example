# Copy to .env.local and fill in. Never commit real keys.

# true (default) = no external API calls at all: canned transcripts, sample cards, browser TTS.
MOCK_MODE=true

# Gnani Vachana (STT + TTS). Sent as the X-API-Key-ID header.
GNANI_API_KEY=

# Google Gemini (JSON-mode understanding + card reading).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# HMAC key for signing slip QR codes and the staff cookie (32+ random hex chars).
SLIP_SIGNING_SECRET=

# Branch PIN for the staff console (/console). 4+ characters.
STAFF_PIN=

# Supabase storage (optional). Without both values the app stores JSON files in ./data.
# The secret (service_role) key is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
